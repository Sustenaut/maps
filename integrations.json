{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets",
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        ".github/workflows/deploy.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    }
  ],
  "other_hosts": [
    {
      "host": "gsavalik.envir.ee",
      "reason": "The Estonian Land Board open-data WFS, read when maps are built; no account or key"
    },
    {
      "host": "maaruum.ee",
      "reason": "A credit link on the map"
    },
    {
      "host": "www.rmk.ee",
      "reason": "A credit link on the map"
    }
  ]
}
