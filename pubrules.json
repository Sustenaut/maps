{
  "kind": "service",
  "bin": "maps",
  "ci": {
    "with": {
      "apt-packages": "tippecanoe",
      "setup": "make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets bin/maps"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "cache": {
    "data": {
      "path": "data",
      "refresh": "run"
    },
    "packs": {
      "path": ".packcache",
      "unit": "data/areas/{unit}/",
      "inputs": [
        "data/boundaries.geojsonl",
        "mapbuild/*.py"
      ],
      "tools": [
        "tippecanoe --version"
      ]
    },
    "overview": {
      "path": ".packcache/overview",
      "inputs": [
        "data/national/",
        "data/boundaries.geojsonl",
        "mapbuild/*.py"
      ],
      "tools": [
        "tippecanoe --version"
      ]
    }
  },
  "site": {
    "check_dir": "site"
  },
  "security": {
    "sonar": {
      "args": "-Dsonar.sources=. -Dsonar.tests=tests -Dsonar.exclusions=tests/**,coverage-download/**"
    }
  },
  "mirror": {
    "wheels": "https://storage.sustenaut.eu/wheels",
    "terraform": "https://storage.sustenaut.eu/terraform",
    "pypi": "https://storage.sustenaut.eu/pypi"
  }
}
