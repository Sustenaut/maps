{
  "kind": "service",
  "bin": "maps",
  "ci": {
    "with": {
      "setup": "sudo apt-get update -q && sudo apt-get install -y -q tippecanoe && make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets bin/maps"
    }
  },
  "protect": {
    "checks": [
      "ci / passed"
    ],
    "tags": false
  },
  "cache": {
    "inputs": {
      "data": {
        "path": "data",
        "refresh": "week"
      }
    },
    "outputs": {
      "packs": {
        "dir": ".packcache/areas",
        "unit": [
          "{data}/areas/{path}/",
          "{data}/boundaries.geojsonl"
        ],
        "shared": [
          "mapbuild/*.py",
          "tool: tippecanoe --version"
        ]
      },
      "overview": {
        "dir": ".packcache/overview",
        "unit": [
          "{data}/national/",
          "{data}/boundaries.geojsonl"
        ],
        "shared": [
          "mapbuild/*.py",
          "tool: tippecanoe --version"
        ]
      }
    }
  }
}
