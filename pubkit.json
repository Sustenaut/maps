{
  "kind": "service",
  "bin": "maps",
  "ci": {
    "with": {
      "setup": "sudo apt-get update -q && sudo apt-get install -y -q tippecanoe && make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets bin/maps"
    }
  },
  "protect": {
    "checks": [
      "ci / passed"
    ],
    "tags": false
  },
  "cache": {
    "data": {
      "path": "data",
      "refresh": "run"
    },
    "packs": {
      "path": ".packcache",
      "unit": "data/areas/{unit}/",
      "inputs": [
        "data/boundaries.geojsonl",
        "mapbuild/*.py"
      ],
      "tools": [
        "tippecanoe --version"
      ]
    },
    "overview": {
      "path": ".packcache/overview",
      "inputs": [
        "data/national/",
        "data/boundaries.geojsonl",
        "mapbuild/*.py"
      ],
      "tools": [
        "tippecanoe --version"
      ]
    }
  },
  "site": {
    "check_dir": "site"
  }
}
