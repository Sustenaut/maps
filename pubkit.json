{
  "kind": "service",
  "bin": "maps",
  "ci": {
    "with": {
      "setup": "sudo apt-get update -q && sudo apt-get install -y -q tippecanoe && make venv node",
      "test": "make functional",
      "shellcheck": "with-secrets bin/maps"
    }
  },
  "protect": {
    "checks": [
      "ci / passed"
    ],
    "tags": false
  }
}
